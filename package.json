{
  "name": "film-exif-editor-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Film EXIF Editor - Desktop app and marketing website monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"desktop,website\" -c \"blue,green\" \"npm run dev --workspace desktop\" \"npm run dev --workspace website\"",
    "dev:desktop": "npm run dev --workspace desktop",
    "dev:website": "npm run dev --workspace website",
    "build": "npm run build --workspaces",
    "build:desktop": "npm run build --workspace desktop",
    "build:website": "npm run build --workspace website",
    "dist": "npm run dist --workspace desktop",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
