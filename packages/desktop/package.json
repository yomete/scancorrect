{
  "name": "desktop",
  "private": true,
  "version": "0.3.1",
  "description": "ScanCorrect - Desktop Electron application",
  "author": {
    "name": "Yomi Eluwande",
    "email": "yomi.eluwande@gmail.com"
  },
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p electron --watch\" \"wait-on http://localhost:5173 && ELECTRON_RUN_AS_NODE= electron .\"",
    "build": "tsc -p electron && vite build",
    "preview": "vite preview",
    "electron": "ELECTRON_RUN_AS_NODE= electron .",
    "electron:dev": "tsc -p electron && ELECTRON_RUN_AS_NODE= electron .",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "clean": "rm -rf dist dist-electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "happy-dom": "^15.0.0",
    "msw": "^2.4.0",
    "playwright": "^1.48.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0",
    "zustand": "^5.0.9"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "exiftool-vendored": "^35.20.0",
    "fast-xml-parser": "^5.8.0"
  },
  "build": {
    "appId": "com.scancorrect.app",
    "productName": "ScanCorrect",
    "electronVersion": "31.0.2",
    "npmRebuild": false,
    "compression": "maximum",
    "icon": "build/icon.icns",
    "directories": {
      "output": "../../release",
      "app": "."
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*",
      "!**/*.{map,d.ts}",
      "!**/{test,tests,__tests__,example,examples,doc,docs}/**"
    ],
    "asarUnpack": [
      "node_modules/exiftool-vendored*/**/*",
      "node_modules/@photostructure/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "deb": {
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator1",
        "libxtst6",
        "libnss3",
        "perl"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
